// Agent Space — Prisma schema
// Source of truth: docs/Product_Specification.md (v1.2)
//
// Conventions
// - Table names are snake_case plural via @@map; columns are snake_case.
// - Primary keys are UUID strings. Foreign keys are named <relation>_id.
// - Soft deletes use deleted_at (30-day restore window for skills, artifacts, files, credentials).
// - Settings that are "the source of truth" live here as typed columns; Redis only holds counters/caches.
// - Secret VALUES are never stored here (only Secret Manager resource names and masked hints). See §8.7.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

