{
  "name": "agentspace-desktop",
  "productName": "Agent Space",
  "version": "1.0.10",
  "description": "Agent Space desktop app (Windows, Mac) — the app/ build inside Electron (§14.2)",
  "private": true,
  "main": "dist/main.js",
  "author": "Agent Space",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:device": "npm run build && node scripts/test-device.mjs",
    "dev": "npm run build && electron . --dev",
    "start": "npm run build && electron .",
    "web": "npm --prefix ../app run build",
    "package:win": "npm run web && npm run build && electron-builder --win",
    "package:mac": "npm run web && npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "release": "node scripts/release.mjs",
    "release:win": "node scripts/release.mjs --win",
    "release:mac": "node scripts/release.mjs --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nut-tree-fork/nut-js": "4.2.6",
    "electron-updater": "6.8.11",
    "get-windows": "9.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@google-cloud/storage": "8.4.0",
    "@types/node": "22.19.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "js-yaml": "4.1.0",
    "typescript": "5.9.3"
  }
}
